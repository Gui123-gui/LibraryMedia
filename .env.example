# Copy to .env and replace the example values before starting Docker Compose.
DB_USERNAME=librarymedia
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
TMDB_API_KEY=replace-with-your-tmdb-api-key
OPEN_LIBRARY_USER_AGENT=PersonalMediaLibrary/1.0 (contact: your-email@example.com)
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://localhost:3000
